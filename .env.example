DATABASE_URL="file:./dev.db"

# Docker Compose (trong container dùng đường dẫn tuyệt đối)
# DATABASE_URL="file:/data/app.db"

# NextAuth (Auth.js v5) — bắt buộc khi chạy production
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-dai-dung-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# --- VPS (chung máy với n8n, HRM, …) — không đụng các stack đang chạy ---
# COMPOSE_PROJECT_NAME: tên riêng mỗi site (vd: web_shop_a) — tách volume/container/network.
# HOST_PORT: port trống trên máy (kiểm tra: ss -tlnp | grep LISTEN). Tránh trùng port các dịch vụ khác.
# HOST_BIND=127.0.0.1 — chỉ reverse proxy trên cùng VPS gọi được; không mở thẳng ra internet.
# AUTH_URL: URL công khai https://tenmien.com (khớp domain trong Caddy/Nginx).
#
# COMPOSE_PROJECT_NAME=web_shop_a
# HOST_BIND=127.0.0.1
# HOST_PORT=3040
# AUTH_URL="https://shop-a.com"

# Đăng ký / đăng nhập: bảng `users` (mật khẩu bcrypt). Role ADMIN mới vào `/admin`.
# Không set ADMIN_REGISTRATION_EMAIL: tài khoản đăng ký đầu tiên = ADMIN, các tài khoản sau = USER.
# Có set: chỉ email khớp (đăng ký) mới được ADMIN; còn lại = USER.
# Payoneer (tùy chọn): sau khi đặt hàng với Payoneer, chuyển hướng trình duyệt tới URL thanh toán.
# Placeholder: {orderNumber} {amount} {currency} — ví dụ: https://your-pay-page.com/pay?ref={orderNumber}&sum={amount}&ccy={currency}
# PAYONEER_CHECKOUT_URL_TEMPLATE=
